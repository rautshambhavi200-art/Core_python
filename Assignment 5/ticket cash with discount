passengers = int(input('Enter number of passengers:'))
ticket = float(input('Enter ticket price:'))

total_amount = 0

for i in range(1, passengers + 1):
    age = int(input(f'Enter age of passenger {i}:'))

    if age < 12:
        amount = ticket * 0.80
    elif age > 59:
        amount = ticket * 0.70
    else:
        amount = ticket
    total_amount += amount

print('Total Ticket Amount =', total_amount)