def count_digits(num):
    count = 0
    temp = num
    while temp>0:
        count += 1
        temp //= 10
    return count

def armstrong(num):
    digits = count_digits(num)
    temp = num
    total = 0

    while temp > 0:
        digit = temp % 10
        total += digit ** digits
        temp //= 10
    return total == num

num = int(input("Enter a number:"))

if armstrong(num):
    print('Armstrong number')
else:
    print('Not an armstrong number')