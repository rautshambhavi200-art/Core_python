nums = [-10, -3, 2, 8, 5]
pairs = set()
for i in range(len(nums)):
    for j in range(i + 1, len(nums)):
        pairs.add((nums[i], nums[j], nums[i] * nums[j]))
best = None
for pair in pairs:
    if best is None or pair[2] > best[2]:
        best = pair
print("Pair:", (best[0], best[1]))
print("Product:", best[2])