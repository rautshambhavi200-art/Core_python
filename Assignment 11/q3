data = [[1, 5], [3, 2], [4, 8], [2, 1]]
# Bubble sort the outer list by item at index 1
i = 0
while i < len(data):
    j = 0
    while j < len(data) - 1 - i:
        if data[j][1] > data[j + 1][1]:
            data[j], data[j + 1] = data[j + 1], data[j]
        j += 1
    i += 1
print(data)