nums = [12, 5, 27, 8, 3]
i = 0
while i < len(nums):
    j = 0
    while j < len(nums) - 1 - i:
        if nums[j] > nums[j + 1]:
            nums[j], nums[j + 1] = nums[j + 1], nums[j]
        j += 1
    i += 1
if len(nums) >= 2:
    print("Second largest:", nums[-2])
else:
    print("Not enough elements")